{
  "id": "/ping-dashboard/",
  "name": "Ping: placement updates",
  "short_name": "Ping",
  "description": "Your IIT KGP placement updates, only the ones that are about you.",
  "start_url": "/ping-dashboard/?source=app#chat",
  "scope": "/ping-dashboard/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#f4f2ec",
  "theme_color": "#0d6b61",
  "categories": ["education", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Today", "url": "/ping-dashboard/?source=app#today", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Companies", "url": "/ping-dashboard/?source=app#companies", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
